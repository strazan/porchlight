<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Merged with the Info.plist Xcode generates from build settings. -->
<plist version="1.0">
<dict>
    <!-- Local MCP servers (e.g. Obsidian's on http://127.0.0.1:27123) often serve plain HTTP. -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsLocalNetworking</key>
        <true/>
    </dict>
</dict>
</plist>
