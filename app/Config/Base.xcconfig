// Settings shared by everyone who builds Porchlight.
//
// By default the app is signed to run locally only. To sign with your own Apple
// Developer team (a stable signature: no repeated Keychain prompts, and ready to
// notarize), create Signing.local.xcconfig next to this file, e.g.:
//
//   DEVELOPMENT_TEAM = ABCDE12345
//   CODE_SIGN_STYLE = Manual
//   CODE_SIGN_IDENTITY = Developer ID Application
//
// It's gitignored, so your team stays out of the repository.

PRODUCT_BUNDLE_IDENTIFIER = sh.porchlight.Porchlight
// Releases override both (scripts/release.sh): the version, and the commit count as the build.
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1

CODE_SIGN_STYLE = Automatic
CODE_SIGN_IDENTITY = -
CODE_SIGN_ENTITLEMENTS = Config/Porchlight.entitlements
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon

#include? "Signing.local.xcconfig"
