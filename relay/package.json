{
  "name": "@porchlight/relay",
  "version": "0.1.0",
  "description": "The relay Porchlight deploys to your Cloudflare account: OAuth for cloud agents, tunneled to your Mac.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/strazan/porchlight.git",
    "directory": "relay"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "wrangler dev",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "node e2e/sdk-oauth.mjs",
    "e2e:queue": "node e2e/offline-queue.mjs",
    "bundle": "node scripts/bundle.mjs",
    "bundle:check": "node scripts/bundle.mjs --check"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.149.0"
  },
  "allowScripts": {
    "workerd@1.20261006.1": true,
    "esbuild@0.28.2": true
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.2.3"
  }
}
