{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "porchlight-relay",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  // Client ID Metadata Documents are fetched from client-chosen URLs: never reach private networks.
  "compatibility_flags": ["global_fetch_strictly_public"],
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "HUB", "class_name": "Hub" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Hub"] }],
  // OAuth clients, grants and tokens. Created automatically on first deploy.
  "kv_namespaces": [{ "binding": "OAUTH_KV" }],
  "observability": { "enabled": true }
  // Secrets (not in this file):
  //   AGENT_SECRET — shared with the Porchlight app. `wrangler secret put AGENT_SECRET`
  //   For local dev put it in .dev.vars
}
