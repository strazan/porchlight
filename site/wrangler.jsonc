// The website, porchlight.sh: the static files in docs/, served by Cloudflare.
// Deploy with `make site` (needs `npx wrangler login` once, to the account that has the domain).
{
	"$schema": "../relay/node_modules/wrangler/config-schema.json",
	"name": "porchlight-site",
	"compatibility_date": "2026-10-01",
	"assets": {
		"directory": "../docs",
		"html_handling": "auto-trailing-slash",
		"not_found_handling": "none"
	},
	"routes": [{ "pattern": "porchlight.sh", "custom_domain": true }],
	"workers_dev": false
}
